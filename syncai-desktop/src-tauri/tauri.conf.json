{
  "productName": "SyncAI",
  "version": "0.1.0",
  "identifier": "com.syncai.app",
  "build": {
    "frontendDist": "https://syncai-frontend-seven.vercel.app",
    "devUrl": "https://syncai-frontend-seven.vercel.app",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "SyncAI",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "userAgent": "SyncAI-Desktop/0.1.0 AppleWebKit/537.36"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
