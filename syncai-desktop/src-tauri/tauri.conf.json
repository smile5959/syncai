{
  "productName": "SyncAI",
  "version": "0.1.0",
  "identifier": "com.syncai.app",
  "build": {
    "frontendDist": "../../syncai-frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../syncai-frontend && npm run build:tauri"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
